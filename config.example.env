# Copy to /etc/zmwall.env (the installer does this automatically).
ZMWALL_BIND=127.0.0.1
ZMWALL_PORT=8080
ZMWALL_SECRET_KEY=CHANGE-ME
ZMWALL_DB=/var/lib/zmwall/zmwall.db
ZMWALL_DISPLAY=:0

# Die Weboberfläche ist bis zum ersten erfolgreichen ZoneMinder-Sync offen.
# Danach werden die eingegebenen Browser-Zugangsdaten direkt gegen ZoneMinder geprüft.
