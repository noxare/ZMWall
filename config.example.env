# Copy to /etc/zmwall.env (the installer does this automatically).
ZMWALL_BIND=0.0.0.0
ZMWALL_PORT=8080
ZMWALL_ADMIN_USER=admin
# Generate with: python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('CHANGE-ME'))"
ZMWALL_ADMIN_PASSWORD_HASH=
ZMWALL_DB=/var/lib/zmwall/zmwall.db
ZMWALL_DISPLAY=:0

